# BSA production deployment
BSA_ENV=production
BSA_JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BSA_MFA_KEY=REPLACE_WITH_AN_INDEPENDENT_32_PLUS_RANDOM_CHARACTERS
BSA_ADMIN_EMAIL=admin@example.com
BSA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
BSA_TOKEN_TTL=28800
BSA_SESSION_IDLE_TIMEOUT=1800
BSA_ALLOWED_ORIGINS=https://asm.example.com
BSA_ALLOWED_HOSTS=asm.example.com

# Production asset/finding persistence is PostgreSQL and fails closed without a DSN.
BSA_ASSET_REPOSITORY_BACKEND=postgres
BSA_DATABASE_URL=postgresql://bsa:REPLACE_WITH_DB_PASSWORD@postgres:5432/bsa
# Emergency-only compatibility escape hatch. Keep disabled in production.
BSA_ALLOW_LEGACY_STORAGE=0

# Legacy/local stores still used by subsystems that are being migrated separately.
BSA_AUTH_DB=/data/bsa_auth.db
BSA_HISTORY_DB=/data/bsa_history.db
BSA_JOBS_DB=/data/bsa_jobs.db
BSA_DEMO_DATA=0
BSA_AI_ENABLED=1
BSA_OLLAMA_URL=http://ai-proxy:11435
BSA_OLLAMA_PROXY_TOKEN=REPLACE_WITH_A_32_PLUS_RANDOM_SECRET
# Internal proxy-only setting; API should not point directly at Ollama in production.
BSA_OLLAMA_UPSTREAM_URL=http://ollama:11434
BSA_OLLAMA_MODEL=qwen2.5:7b
BSA_AI_TIMEOUT=15

# Optional OIDC SSO. Disabled unless issuer, client id and redirect URI are set.
BSA_OIDC_ISSUER=
BSA_OIDC_CLIENT_ID=
BSA_OIDC_CLIENT_SECRET=
BSA_OIDC_REDIRECT_URI=https://asm.example.com/api/v1/auth/sso/callback
BSA_OIDC_SUCCESS_URL=/
BSA_OIDC_SCOPES=openid email profile
BSA_OIDC_REQUIRE_EMAIL_VERIFIED=1
# Optional comma-separated ACR values that your IdP documents as MFA.
BSA_OIDC_MFA_ACR_VALUES=

# Optional SIEM / Syslog integration
# Prefer TLS (RFC5424-style framing over TCP/TLS).
BSA_SYSLOG_HOST=
BSA_SYSLOG_PORT=6514
BSA_SYSLOG_TRANSPORT=tls
BSA_SYSLOG_FACILITY=16
BSA_SYSLOG_APP_NAME=be-safe-asm
BSA_SYSLOG_TIMEOUT=5
# Optional custom CA / SNI for private collectors.
BSA_SYSLOG_CA_FILE=
BSA_SYSLOG_SERVER_NAME=
