FROM ghcr.io/zaproxy/zaproxy:stable AS zap

FROM golang:1.24-bookworm AS engines

RUN GOBIN=/out go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
 && CGO_ENABLED=0 GOBIN=/out go install github.com/owasp-amass/amass/v5/cmd/amass@main \
 && GOBIN=/out go install github.com/projectdiscovery/httpx/cmd/httpx@latest \
 && GOBIN=/out go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
 && GOBIN=/out go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest \
 && GOBIN=/out go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest \
 && GOBIN=/out go install github.com/projectdiscovery/tlsx/cmd/tlsx@latest \
 && GOBIN=/out go install github.com/projectdiscovery/asnmap/cmd/asnmap@latest \
 && GOBIN=/out go install github.com/projectdiscovery/katana/cmd/katana@latest \
 && GOBIN=/out go install github.com/lc/gau/v2/cmd/gau@latest \
 && GOBIN=/out go install github.com/trufflesecurity/trufflehog/v3@latest \
 && GOBIN=/out go install github.com/tomnomnom/assetfinder@latest \
 && GOBIN=/out go install github.com/projectdiscovery/alterx/cmd/alterx@latest \
 && GOBIN=/out go install github.com/d3mondev/puredns/v2@latest

FROM debian:bookworm-slim AS massdns
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git build-essential \
 && git clone --depth 1 https://github.com/blechschmidt/massdns.git /src/massdns \
 && make -C /src/massdns \
 && mkdir -p /out \
 && cp /src/massdns/bin/massdns /out/massdns \
 && rm -rf /var/lib/apt/lists/*

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git nmap whatweb default-jre-headless \
 && rm -rf /var/lib/apt/lists/*

COPY --from=engines /out/ /usr/local/bin/
COPY --from=massdns /out/massdns /usr/local/bin/massdns
COPY --from=zap /zap/ /opt/zap/

RUN ln -s /opt/zap/zap-baseline.py /usr/local/bin/zap-baseline.py \
 && git clone --depth 1 https://github.com/drwetter/testssl.sh.git /opt/testssl.sh \
 && ln -s /opt/testssl.sh/testssl.sh /usr/local/bin/testssl.sh

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir gvm-tools

COPY app ./app

ENV BSA_ENGINE_BUNDLE=full
ENV BSA_GVM_SOCKET=/run/gvmd/gvmd.sock

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
