FROM ghcr.io/zaproxy/zaproxy:stable AS zap

FROM golang:1.26-bookworm AS engines

RUN set -eux; \
    export GOBIN=/out GOPROXY=https://proxy.golang.org,direct GODEBUG=http2client=0; \
    retry() { \
      n=0; \
      until "$@"; do \
        n=$((n+1)); \
        if [ "$n" -ge 3 ]; then return 1; fi; \
        sleep $((n*3)); \
      done; \
    }; \
    retry go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.11.1; \
    retry env CGO_ENABLED=0 GOBIN=/out GOPROXY="$GOPROXY" GODEBUG="$GODEBUG" go install github.com/owasp-amass/amass/v5/cmd/amass@v5.1.1; \
    retry go install github.com/projectdiscovery/httpx/cmd/httpx@v1.12.0; \
    retry go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.16.0; \
    retry go install github.com/projectdiscovery/dnsx/cmd/dnsx@v1.3.1; \
    retry go install github.com/projectdiscovery/naabu/v2/cmd/naabu@v2.6.1; \
    retry go install github.com/projectdiscovery/tlsx/cmd/tlsx@v1.4.0; \
    retry go install github.com/projectdiscovery/asnmap/cmd/asnmap@v1.1.1; \
    retry go install github.com/projectdiscovery/katana/cmd/katana@v1.7.0; \
    retry go install github.com/lc/gau/v2/cmd/gau@v2.2.4; \
    retry go install github.com/trufflesecurity/trufflehog/v3@v3.97.9; \
    retry go install github.com/tomnomnom/assetfinder@v0.1.0; \
    retry go install github.com/projectdiscovery/alterx/cmd/alterx@v0.1.0; \
    retry go install github.com/d3mondev/puredns/v2@v2.1.1

FROM debian:bookworm-slim AS nuclei_templates
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && git clone --depth 1 --branch v10.4.8 https://github.com/projectdiscovery/nuclei-templates.git /out/nuclei-templates \
 && rm -rf /out/nuclei-templates/.git /var/lib/apt/lists/*

FROM debian:bookworm-slim AS massdns
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git build-essential \
 && git clone --depth 1 --branch v1.1.0 https://github.com/blechschmidt/massdns.git /src/massdns \
 && make -C /src/massdns \
 && mkdir -p /out \
 && cp /src/massdns/bin/massdns /out/massdns \
 && rm -rf /var/lib/apt/lists/*

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git nmap whatweb default-jre-headless \
 && rm -rf /var/lib/apt/lists/*

COPY --from=engines /out/ /usr/local/bin/
COPY --from=massdns /out/massdns /usr/local/bin/massdns
COPY --from=nuclei_templates /out/nuclei-templates /opt/nuclei-templates
COPY --from=zap /zap/ /opt/zap/

RUN ln -s /opt/zap/zap-baseline.py /usr/local/bin/zap-baseline.py \
 && git clone --depth 1 --branch v3.2.4 https://github.com/drwetter/testssl.sh.git /opt/testssl.sh \
 && ln -s /opt/testssl.sh/testssl.sh /usr/local/bin/testssl.sh \
 && mkdir -p /etc/bsa \
 && printf '%s\n' 1.1.1.1 8.8.8.8 9.9.9.9 > /etc/bsa/puredns-resolvers.txt \
 && printf '%s\n' 8.8.8.8 8.8.4.4 > /etc/bsa/puredns-trusted.txt

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir gvm-tools

COPY app ./app

ENV BSA_ENGINE_BUNDLE=full
ENV BSA_GVM_SOCKET=/run/gvmd/gvmd.sock
ENV BSA_NUCLEI_TEMPLATES=/opt/nuclei-templates
ENV BSA_PUREDNS_RESOLVERS=/etc/bsa/puredns-resolvers.txt
ENV BSA_PUREDNS_TRUSTED_RESOLVERS=/etc/bsa/puredns-trusted.txt

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
